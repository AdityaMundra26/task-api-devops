#!/bin/bash
# {{ ansible_managed }}
# Minimal service script for hosts without systemd (e.g. a Docker container).
# Usage: {{ app_control_script }} {start|stop|restart|status}

PIDFILE={{ app_pid_file }}
LOGFILE={{ app_log_file }}
JAR={{ app_jar_path }}

load_env() {
  set -a
  . {{ app_env_file }}
  set +a
}

is_running() {
  start-stop-daemon --status --pidfile "$PIDFILE"
}

start() {
  if is_running; then
    echo "{{ app_name }} already running"
    return 0
  fi
  load_env
  touch "$LOGFILE" && chown {{ app_user }}:{{ app_user }} "$LOGFILE"
  start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid {{ app_user }} --chdir {{ app_dir }} --output "$LOGFILE" \
    --exec /usr/bin/java -- -jar "$JAR"
  echo "{{ app_name }} started"
}

stop() {
  start-stop-daemon --stop --pidfile "$PIDFILE" --retry 15 --oknodo --remove-pidfile
  echo "{{ app_name }} stopped"
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  if is_running; then echo "{{ app_name }} running"; else echo "{{ app_name }} stopped"; exit 3; fi ;;
  *)       echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
